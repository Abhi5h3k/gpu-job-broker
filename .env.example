# Copy this file to .env to override any default setting (optional -- the
# service runs with sensible defaults even with no .env file at all).
# No secrets are needed anywhere in this project; this file exists purely
# for tunable, non-sensitive configuration.
 
# Where the SQLite database file lives.
BROKER_DB_PATH=data/broker.db
 
# Minutes a node can sit with zero running jobs before the idle reaper
# terminates it. See docs/DESIGN.md for why this default was chosen.
BROKER_IDLE_REAPER_MINUTES=15
 
# Hard cap on simultaneously alive nodes (on-demand + interruptible combined).
BROKER_MAX_NODES=10
 
# "balanced" (default, cost-aware with fairness) or "latency_first"
# (always launch a dedicated on-demand node immediately). See
# docs/DESIGN.md's "Replay & policy comparison" section.
BROKER_SCHEDULING_POLICY=balanced
 
# If true, a node may only ever run jobs from one team at a time (stricter,
# costlier). Default false matches the literal requirement that a node may
# be shared across teams when GPUs are free.
BROKER_ISOLATE_TEAMS_PER_NODE=false
 